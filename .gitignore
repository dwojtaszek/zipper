.zipper-runner/.env
.zipper-runner/logs/
.zipper-runner/state/
.zipper-runner/runner.lock
.zipper-runner/babysit.lock
# A lock left here by an in-repo copy of deploy-main.sh would otherwise count as
# untracked dirt in the runner's own checkout (`_repo_is_clean` counts untracked
# files). The supported install puts the lock outside the checkout; this is the
# safety net for running the copy that lives in the tree.
.zipper-runner/.deploy.lock
.zipper-runner/deploy.lock
# The lock the runner and deploy-main.sh share around main-checkout mutations. It
# lives in the checkout by design (next to runner.lock) and must stay ignored for
# the same reason.
.zipper-runner/repo-mutation.lock
.zipper-runner/**/__pycache__/
__pycache__/
*.pyc

# Local cache
cache/



