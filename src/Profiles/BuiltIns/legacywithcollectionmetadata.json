      "required": true,
      "emptyPercentage": 0,
      "multiValue": false
    },
    {
      "name": "DEDUPE_GROUP_ID",
      "type": "identifier",
      "required": true,
      "emptyPercentage": 0,
      "multiValue": false
    },
    {
      "name": "PROCESSING_STATUS",
      "type": "coded",
      "required": true,
      "emptyPercentage": 0,
      "multiValue": false,
      "dataSource": "processingstatus"
    }
  ]
}