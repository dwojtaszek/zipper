<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!--
      RS1036: "A project containing analyzers should specify EnforceExtendedAnalyzerRules=true."
      RS2008: "Enable analyzer release tracking for the analyzer project."
      Suppressed: analyzer is repo-internal (not published to NuGet).
    -->
    <NoWarn>$(NoWarn);RS1036;RS2008</NoWarn>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Keep this reference at or below the compiler version in global.json's SDK (CS9057).
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zipper.Analyzers.Tests" />
  </ItemGroup>

</Project>
