#!/bin/bash
# Pre-commit hook — format + unit tests on the STAGED snapshot.
# Installs to: $(git rev-parse --git-common-dir)/hooks/pre-commit
#
# The success marker is written by the companion post-commit hook, because
# this hook runs BEFORE the commit object exists (so the "skip if recent"
# logic in pre-push can compare against the new commit's HEAD, not its parent).
#
# To bypass (not recommended): git commit --no-verify

set -u

# ──────────────────────────────────────────────────
# 0. Short-circuit if only docs/markdown changed
# Include Deletions, Renames, and Copies so a D- or R-only commit still
# runs format/tests (a deletion can still break compilation elsewhere).
# ──────────────────────────────────────────────────
STAGED=$(git diff --cached --name-only --no-renames --diff-filter=ACMRDTUX)
if [[ -z "$STAGED" ]]; then
    exit 0
fi

# Catch staged whitespace before SDK discovery, stashing, or tests.
if ! git diff --cached --check; then
    exit 1
fi

record_verified_scope() {
    PENDING_DIR=$(git rev-parse --git-path zipper-hooks 2>/dev/null || echo "")
    if [[ -n "$PENDING_DIR" ]]; then
        mkdir -p "$PENDING_DIR" 2>/dev/null || true
        STAGED_TREE=$(git write-tree 2>/dev/null || echo "")
        printf 'timestamp=%s\npid=%s\ntree=%s\nscope=%s\n' "$(date +%s)" "$$" "$STAGED_TREE" "$1" \
            > "$PENDING_DIR/pre-commit.pending" 2>/dev/null || true
    fi
}

if ! command -v dotnet >/dev/null 2>&1; then
    echo "❌ dotnet not found. Commit aborted." >&2
    echo "   Install the .NET SDK or bypass with: git commit --no-verify" >&2
    exit 1
fi

# ──────────────────────────────────────────────────
# 1. Stash unstaged changes so we test the exact commit
# ──────────────────────────────────────────────────
STASH_REF=""
UNSTAGED_EXISTS=false
STASH_FLAGS=(--keep-index --quiet)
# Scope untracked isolation to product, runner, and gate sources; unrelated notes do not
# trigger an unnecessary git stash push/pop cycle.
UNTRACKED_SRC=$(git ls-files --others --exclude-standard -- src/ .zipper-runner/ .github/scripts/ tests/ci/)
if [[ -n "$UNTRACKED_SRC" ]]; then
    UNSTAGED_EXISTS=true
    STASH_FLAGS+=(--include-untracked)
elif ! git diff --quiet; then
    UNSTAGED_EXISTS=true
fi

if [[ "$UNSTAGED_EXISTS" == "true" ]]; then
    STASH_MSG="pre-commit-$(date +%s)-$$"
    # Capture stash output so we can surface the real reason if it fails —
    # silently continuing would test a dirty working tree, violating the
    # "format/test the staged snapshot" contract.
    STASH_ERR=$(git stash push "${STASH_FLAGS[@]}" -m "$STASH_MSG" 2>&1)
    STASH_RC=$?
    if [[ "$STASH_RC" -ne 0 ]]; then
        echo "❌ git stash push failed (exit $STASH_RC). Aborting commit to avoid" >&2
        echo "   testing against a dirty working tree." >&2
        [[ -n "$STASH_ERR" ]] && echo "   Details: $STASH_ERR" >&2
        echo "   Commit your unstaged changes (or use --no-verify) and retry." >&2
        exit 1
    fi
    STASH_REF=$(git stash list --format='%gd %gs' | grep -F "$STASH_MSG" | awk '{print $1}' | head -1)
fi

_CLEANUP_RAN=false
cleanup() {
    local rc=$?
    # Ensure single run even if both INT/TERM and EXIT fire.
    if [[ "$_CLEANUP_RAN" == "true" ]]; then
        exit "$rc"
    fi
    _CLEANUP_RAN=true
    if [[ -n "$STASH_REF" ]]; then
        git stash pop --quiet "$STASH_REF" >/dev/null 2>&1 || \
            echo "⚠ Could not restore stash $STASH_REF — run 'git stash list' to recover." >&2
        STASH_REF=""
    fi
    exit "$rc"
}
trap cleanup EXIT
# INT/TERM: just mark; EXIT will then run cleanup once.
trap 'exit 130' INT
trap 'exit 143' TERM

if printf '%s\n' "$STAGED" | grep -qE '^(\.github/workflows/(ci|pr|build-and-test)\.yml|tests/test-unified-workflow\.(sh|bat))$'; then
    echo "▶ Validating staged workflow structure..."
    bash tests/test-unified-workflow.sh || exit 1
fi

# Docs-only = every staged file matches one of the doc patterns.
# Runs after staging isolation so DocsDriftTests evaluates the exact staged markdown snapshot.
TOTAL=$(printf '%s\n' "$STAGED" | grep -c .)
DOCS=$(printf '%s\n' "$STAGED" | grep -c -E '^(docs/|CHANGELOG(\.md)?$|.*\.(md|markdown)$)' || true)
RUNNER_ONLY=false
DOCS_ONLY=false
if [[ -f .github/scripts/change-scope.py ]]; then
    SCOPE=$(python3 .github/scripts/change-scope.py --staged) || exit 1
    [[ "$SCOPE" == *"only_runner=true"* ]] && RUNNER_ONLY=true
    [[ "$SCOPE" == *"only_docs=true"* ]] && DOCS_ONLY=true
elif [[ "$TOTAL" -gt 0 && "$DOCS" -eq "$TOTAL" ]]; then
    DOCS_ONLY=true
fi
if [[ "$DOCS_ONLY" == "true" || "$RUNNER_ONLY" == "true" ]]; then
    if [[ -f "src/Zipper.Tests/Zipper.Tests.csproj" ]]; then
        echo "▶ Pre-commit (docs-only): running DocsDriftTests..."
        DRIFT_ARGS=(dotnet test src/Zipper.Tests/Zipper.Tests.csproj --filter "FullyQualifiedName~DocsDriftTests" --logger "console;verbosity=quiet")
        if ! "${DRIFT_ARGS[@]}"; then
            echo "❌ DocsDriftTests failed. Commit aborted." >&2
            echo "   Run 'dotnet test src/Zipper.Tests/Zipper.Tests.csproj --filter FullyQualifiedName~DocsDriftTests' for full output." >&2
            echo "   To bypass: git commit --no-verify" >&2
            exit 1
        fi
    fi
    if [[ "$RUNNER_ONLY" == "true" ]]; then
        echo "▶ Running runner tests for the staged runner-only change..."
        (
            # Fixtures create other repositories; hook-local Git variables must stay here.
            while IFS= read -r git_env; do unset "$git_env"; done < <(git rev-parse --local-env-vars)
            python3 .github/scripts/run-check.py --log "$(mktemp -t zipper-runner-check.XXXXXX)" -- \
                python3 -m unittest discover -s .zipper-runner/tests -p 'test_*.py'
        ) || exit 1
        record_verified_scope runner
    fi
    echo "✓ Pre-commit: documentation/runner gates passed; unchanged product unit suite skipped."
    exit 0
fi

CI_SCRIPTS_ONLY=false
if [[ -d tests/ci ]]; then
    RUNNER_PREF_MATCH=$(printf '%s\n' "$STAGED" | grep -c -E '^\.zipper-runner/' || true)
    CI_MATCHED=$(printf '%s\n' "$STAGED" | grep -c -E '^(\.github/(workflows|scripts)/|tests/ci/|tests/wait-for-reviews\.sh$|tests/test-unified-workflow\.(sh|bat)$|\.pi-lens\.json$|ruff\.toml$|docs/|CHANGELOG(\.md)?$|.*\.(md|markdown)$)' || true)
    if [[ "$TOTAL" -gt 0 && "$RUNNER_PREF_MATCH" -eq 0 && "$CI_MATCHED" -eq "$TOTAL" ]]; then
        CI_SCRIPTS_ONLY=true
    fi
fi
if [[ "$CI_SCRIPTS_ONLY" == "true" ]]; then
    echo "▶ Pre-commit (CI/workflow/script-only): running tests/ci..."
    (
        while IFS= read -r git_env; do unset "$git_env"; done < <(git rev-parse --local-env-vars)
        python3 .github/scripts/run-check.py --log "$(mktemp -t zipper-ci-check.XXXXXX)" -- \
            python3 -m unittest discover -s tests/ci -p 'test_*.py'
    ) || exit 1
    if [[ -f "src/Zipper.Tests/Zipper.Tests.csproj" ]]; then
        echo "▶ Running DocsDriftTests..."
        dotnet test src/Zipper.Tests/Zipper.Tests.csproj --filter "FullyQualifiedName~DocsDriftTests" --logger "console;verbosity=quiet" || exit 1
    fi
    record_verified_scope ci
    echo "✓ Pre-commit: CI/workflow gates passed; unchanged product unit suite skipped."
    exit 0
fi


# ──────────────────────────────────────────────────
# 2. dotnet format — scoped to staged C# files only
# ──────────────────────────────────────────────────
STAGED_CS=()
while IFS= read -r f; do
    [[ -n "$f" && "$f" == *.cs ]] && STAGED_CS+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [[ ${#STAGED_CS[@]} -gt 0 ]]; then
    echo "▶ Running dotnet format on ${#STAGED_CS[@]} staged C# file(s)..."
    # `dotnet format --include` is a multi-value System.CommandLine option:
    # each file is a separate token, not a space-joined single string. The
    # array-expansion form below is the correct idiom (verified empirically:
    # passing A.cs B.cs this way formats both files).
    if ! dotnet format --verbosity quiet --include "${STAGED_CS[@]}"; then
        echo "❌ dotnet format failed" >&2
        exit 1
    fi

    # Only treat formatting of *staged* files as a hard failure.
    if ! git diff --quiet -- "${STAGED_CS[@]}"; then
        echo "❌ Formatting changes required on staged files. They have been auto-formatted." >&2
        echo "   Please review and 'git add' them, then commit again." >&2
        git --no-pager diff --stat -- "${STAGED_CS[@]}"
        exit 1
    fi
else
    echo "▶ No staged C# files; skipping dotnet format."
fi

# ──────────────────────────────────────────────────
# 3. Unit tests
# ──────────────────────────────────────────────────
echo "▶ Running unit tests..."
UNIT_ARGS=(dotnet test src/Zipper.Tests/Zipper.Tests.csproj --logger "console;verbosity=quiet")
if ! "${UNIT_ARGS[@]}"; then
    echo "❌ Unit tests failed. Commit aborted." >&2
    echo "   Run 'dotnet test' for full output." >&2
    echo "   To bypass: git commit --no-verify" >&2
    exit 1
fi

ANALYZER_TRIGGER=$(printf '%s\n' "$STAGED" | grep -c -E '(^|/)(src/Zipper\.Analyzers/|src/Zipper\.Analyzers\.Tests/|Directory\.Build\.props$|Directory\.Packages\.props$|\.editorconfig$|zipper\.sln$|global\.json$)' || true)
if [[ "$ANALYZER_TRIGGER" -gt 0 ]]; then
    echo "▶ Running analyzer tests..."
    ANALYZER_ARGS=(dotnet test src/Zipper.Analyzers.Tests/Zipper.Analyzers.Tests.csproj --logger "console;verbosity=quiet")
    if ! "${ANALYZER_ARGS[@]}"; then
        echo "❌ Analyzer unit tests failed. Commit aborted." >&2
        echo "   Run 'dotnet test src/Zipper.Analyzers.Tests/Zipper.Analyzers.Tests.csproj' for full output." >&2
        echo "   To bypass: git commit --no-verify" >&2
        exit 1
    fi
fi

echo "✓ Pre-commit: format + unit tests passed"

# Success handshake with post-commit:
#   - pre-commit (here, on success) writes a `pre-commit.pending` sentinel bound to the staged tree hash
#   - post-commit only promotes it to `pre-commit.ok` if the sentinel exists and matches HEAD^{tree}
#   - `git commit --no-verify` skips pre-commit ⇒ no matching sentinel ⇒ no ok marker
#     ⇒ pre-push never wrongly skips unit tests for a bypassed commit.
record_verified_scope full

exit 0
