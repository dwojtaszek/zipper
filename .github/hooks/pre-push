#!/bin/bash
# Pre-push git hook — unit tests + mutation smoke + basic E2E smoke suite.
# Installs to: $(git rev-parse --git-common-dir)/hooks/pre-push
#
# Skips unit tests if the post-commit hook wrote a success marker within the
# last 10 minutes on the current HEAD. Full E2E + coverage checks run in CI.
#
# To bypass (not recommended): git push --no-verify

set -u

SKIP_WINDOW_SECONDS=600

echo "┌──────────────────────────────────────────────────────────┐"
echo "│  Pre-push: Unit Tests + Mutation Smoke + Basic E2E Smoke │"
echo "└──────────────────────────────────────────────────────────┘"

if ! command -v dotnet >/dev/null 2>&1; then
    echo "⚠ dotnet not found; skipping pre-push checks."
    exit 0
fi

if [[ -z "${DOTNET_ROOT:-}" ]]; then
    _DOTNET_BIN=$(readlink -f "$(command -v dotnet)" 2>/dev/null || command -v dotnet)
    export DOTNET_ROOT="$(dirname "$_DOTNET_BIN")"
fi

# ──────────────────────────────────────────────────
# 1. Unit tests — skip if post-commit wrote a recent marker on the same HEAD
# ──────────────────────────────────────────────────
RUN_UNIT_TESTS=true
MARKER=$(git rev-parse --git-path zipper-hooks/pre-commit.ok 2>/dev/null || echo "")
if [[ -n "$MARKER" && -f "$MARKER" ]]; then
    MARKER_TS=$(grep '^timestamp=' "$MARKER" | cut -d= -f2)
    MARKER_HEAD=$(grep '^head=' "$MARKER" | cut -d= -f2)
    CURRENT_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "")
    if [[ -n "$MARKER_TS" && -n "$CURRENT_HEAD" && "$MARKER_HEAD" == "$CURRENT_HEAD" ]]; then
        NOW=$(date +%s)
        AGE=$((NOW - MARKER_TS))
        if [[ "$AGE" -lt "$SKIP_WINDOW_SECONDS" ]]; then
            echo "✓ Unit tests already passed in pre-commit (${AGE}s ago); skipping."
            RUN_UNIT_TESTS=false
        fi
    fi
fi

if [[ "$RUN_UNIT_TESTS" == "true" ]]; then
    echo ""
    echo "▶ Running unit tests..."
    if ! dotnet test src/Zipper.Tests/Zipper.Tests.csproj \
            --logger "console;verbosity=quiet" --nologo; then
        echo ""
        echo "❌ Unit tests failed. Push aborted."
        echo "   Run 'dotnet test' for details."
        echo "   To bypass: git push --no-verify"
        exit 1
    fi
    if ! dotnet test src/Zipper.Analyzers.Tests/Zipper.Analyzers.Tests.csproj \
            --logger "console;verbosity=quiet" --nologo; then
        echo ""
        echo "❌ Analyzer unit tests failed. Push aborted."
        echo "   Run 'dotnet test src/Zipper.Analyzers.Tests/Zipper.Analyzers.Tests.csproj' for details."
        echo "   To bypass: git push --no-verify"
        exit 1
    fi
    echo "✓ Unit tests passed"
fi

# ──────────────────────────────────────────────────
# 2. Mutation smoke (changed source files only) — hard gate
# ──────────────────────────────────────────────────
echo ""
echo "▶ Running mutation smoke on changed files..."
if [[ -f "./tests/run-mutation-smoke.sh" ]]; then
    if ! bash ./tests/run-mutation-smoke.sh; then
        echo ""
        echo "❌ Mutation smoke found surviving mutants. Push aborted."
        echo "   Run 'bash tests/run-mutation-smoke.sh' for details."
        echo "   Add targeted unit tests in src/Zipper.Tests/ to kill surviving mutants."
        echo "   To bypass all: git push --no-verify"
        exit 1
    fi
    echo "✓ Mutation smoke passed"
else
    echo "❌ tests/run-mutation-smoke.sh not found. Push aborted."
    echo "   The mutation smoke script is required for pre-push checks."
    exit 1
fi

# ──────────────────────────────────────────────────
# 3. Basic E2E smoke suite
# ──────────────────────────────────────────────────
echo ""
echo "▶ Running basic E2E smoke tests..."

E2E_RAN=false
case "$(uname -s)" in
    Linux*|Darwin*)
        if [[ -f "./tests/run-e2e-basic.sh" ]]; then
            if ! bash ./tests/run-e2e-basic.sh; then
                echo ""
                echo "❌ Basic E2E smoke tests failed. Push aborted."
                echo "   Run 'bash tests/run-e2e-basic.sh' for details."
                echo "   To bypass: git push --no-verify"
                exit 1
            fi
            E2E_RAN=true
        else
            echo "❌ tests/run-e2e-basic.sh not found. Push aborted."
            echo "   The E2E smoke script is required for pre-push checks."
            exit 1
        fi
        ;;
    MINGW*|MSYS*|CYGWIN*)
        if [[ -f "./tests/run-e2e-basic.bat" ]]; then
            # Git Bash (MSYS2) invokes .bat files directly; no cmd.exe wrapper
            # needed. The previous `cmd.exe //c` form is MSYS-specific and
            # breaks under real Windows cmd.exe (which expects `/c`), and is
            # unnecessary here because MSYS2 handles .bat natively.
            if ! ./tests/run-e2e-basic.bat; then
                echo ""
                echo "❌ Basic E2E smoke tests failed. Push aborted."
                echo "   Run 'tests\\run-e2e-basic.bat' for details."
                echo "   To bypass: git push --no-verify"
                exit 1
            fi
            E2E_RAN=true
        else
            echo "❌ tests/run-e2e-basic.bat not found. Push aborted."
            echo "   The E2E smoke script is required for pre-push checks."
            exit 1
        fi
        ;;
esac

echo ""
if [[ "$E2E_RAN" == "true" ]]; then
    echo "✓ All pre-push checks passed"
    exit 0
else
    echo "❌ E2E smoke tests were skipped. Push aborted."
    exit 1
fi
