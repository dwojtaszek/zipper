#!/bin/bash
# Pre-push git hook — unit tests + mutation smoke + basic E2E smoke suite.
# Installs to: $(git rev-parse --git-common-dir)/hooks/pre-push
#
# Skips unit tests if the post-commit hook wrote a success marker within the
# last 10 minutes on the commit being pushed. Full E2E + coverage checks run in CI.
#
# To bypass (not recommended): git push --no-verify

set -u

SKIP_WINDOW_SECONDS=600

echo "┌──────────────────────────────────────────────────────────┐"
echo "│  Pre-push: Unit Tests + Mutation Smoke + Basic E2E Smoke │"
echo "└──────────────────────────────────────────────────────────┘"

if ! command -v dotnet >/dev/null 2>&1; then
    echo "❌ dotnet not found. Push aborted." >&2
    echo "   Install the .NET SDK or bypass with: git push --no-verify" >&2
    exit 1
fi

if [[ -z "${DOTNET_ROOT:-}" ]]; then
    _DOTNET_BIN=$(readlink -f "$(command -v dotnet)" 2>/dev/null || command -v dotnet)
    export DOTNET_ROOT="$(dirname "$_DOTNET_BIN")"
fi

# ──────────────────────────────────────────────────
# 0. Read outgoing refs from standard input (passed by git push)
# Format per line: <local_ref> <local_sha> <remote_ref> <remote_sha>
# ──────────────────────────────────────────────────
REFS_TO_CHECK=()
TOTAL_REFS_READ=0
DELETIONS_COUNT=0
if [[ ! -t 0 ]]; then
    while read -r local_ref local_sha remote_ref remote_sha; do
        [[ -z "$local_ref" ]] && continue
        ((TOTAL_REFS_READ++)) || true
        # Deletion of remote ref (local_ref is (delete) or local_sha is all zeros)
        if [[ "$local_ref" == "(delete)" || "$local_sha" =~ ^0+$ ]]; then
            ((DELETIONS_COUNT++)) || true
            continue
        fi
        REFS_TO_CHECK+=("$local_ref $local_sha")
    done
fi

# If stdin was provided:
# 1. If all pushed refs were deletions, skip checks
# 2. If 0 refs were read and git push invoked hook ($# >= 2 with remote name/url), remote is up-to-date
if [[ ${#REFS_TO_CHECK[@]} -eq 0 ]]; then
    if [[ "$TOTAL_REFS_READ" -gt 0 && "$DELETIONS_COUNT" -eq "$TOTAL_REFS_READ" ]]; then
        echo "✓ Deleting remote ref(s); skipping pre-push checks."
        exit 0
    elif [[ "$TOTAL_REFS_READ" -eq 0 && $# -ge 2 ]]; then
        echo "✓ Everything up-to-date (no outgoing refs to push); skipping pre-push checks."
        exit 0
    fi
fi

CURRENT_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "")
CURRENT_TREE=$(git rev-parse 'HEAD^{tree}' 2>/dev/null || echo "")

# Helper to compute all files changed for an outgoing ref compared to merge-base.
# Returns 0 on success.
# Returns 2 if the commit has parents but no merge-base could be resolved against origin/main or main.
get_changes_for_ref() {
    local ref="$1"
    local sha="$2"
    local commit
    commit=$(git rev-parse "${sha}^{commit}" 2>/dev/null || echo "$sha")
    local merge_base
    merge_base=$(git merge-base "$commit" origin/main 2>/dev/null || echo "")
    if [[ -z "$merge_base" || "$merge_base" == "$commit" ]]; then
        if [[ "$ref" != "refs/heads/main" && "$ref" != "main" && "$ref" != "HEAD" ]]; then
            merge_base=$(git merge-base "$commit" main 2>/dev/null || echo "")
        fi
    fi
    if [[ -z "$merge_base" ]] && git rev-parse --verify -q "${commit}^" >/dev/null 2>&1; then
        # Range cannot be determined for a non-root commit; fail-safe
        return 2
    fi
    local changed_since_base
    if [[ -n "$merge_base" && "$merge_base" != "$commit" ]]; then
        changed_since_base=$(git diff --name-only "$merge_base" "$commit" 2>/dev/null || true)
    else
        changed_since_base=$(git diff-tree --root --no-commit-id --name-only -r "$commit" 2>/dev/null || true)
    fi
    {
        printf '%s\n' "$changed_since_base"
        git diff --name-only "$commit" 2>/dev/null || true
    } | sed '/^$/d' | sort -u
}

# Fallback for manual invocation or piped runs with no ref lines
if [[ ${#REFS_TO_CHECK[@]} -eq 0 && -n "$CURRENT_HEAD" ]]; then
    REFS_TO_CHECK+=("HEAD $CURRENT_HEAD")
fi

# Verify each outgoing ref matches the checked-out tree.
# Local hooks test the filesystem working tree; testing a commit whose tree
# differs from the checkout would falsely validate the current working tree
# instead of the outgoing changes.
for entry in "${REFS_TO_CHECK[@]}"; do
    local_ref="${entry%% *}"
    local_sha="${entry##* }"
    OUTGOING_TREE=$(git rev-parse "${local_sha}^{tree}" 2>/dev/null || echo "")
    if [[ -z "$OUTGOING_TREE" ]]; then
        echo "❌ Cannot resolve outgoing ref $local_ref ($local_sha). Push aborted." >&2
        exit 1
    fi
    if [[ -n "$CURRENT_TREE" && "$OUTGOING_TREE" != "$CURRENT_TREE" ]]; then
        echo "❌ Cannot validate outgoing ref $local_ref ($local_sha): current checkout tree differs from outgoing tree." >&2
        echo "   Pre-push checks require the working tree to match the commit being pushed." >&2
        echo "   Please check out the branch before pushing, or bypass with: git push --no-verify" >&2
        exit 1
    fi
done

# ──────────────────────────────────────────────────
# 1. Unit tests — skip if post-commit wrote a recent marker for all pushed refs,
#    or run only DocsDriftTests if every branch diff since merge-base is docs-only.
# ──────────────────────────────────────────────────
RUN_UNIT_TESTS=true
MARKER=$(git rev-parse --git-path zipper-hooks/pre-commit.ok 2>/dev/null || echo "")
MARKER_VALID=false
MARKER_HEAD=""
AGE=0
if [[ -n "$MARKER" && -f "$MARKER" ]] && git diff --quiet 2>/dev/null && git diff --cached --quiet 2>/dev/null; then
    MARKER_TS=$(grep '^timestamp=' "$MARKER" | cut -d= -f2)
    MARKER_HEAD=$(grep '^head=' "$MARKER" | cut -d= -f2)
    if [[ -n "$MARKER_TS" && -n "$MARKER_HEAD" ]]; then
        NOW=$(date +%s)
        AGE=$((NOW - MARKER_TS))
        if [[ "$AGE" -ge 0 && "$AGE" -lt "$SKIP_WINDOW_SECONDS" ]]; then
            MARKER_VALID=true
        fi
    fi
fi

# Unit tests can only be skipped if every pushed ref matches the verified commit in pre-commit.ok.
# Pushing a non-current branch or unverified commit cannot borrow validation.
# Note: peel annotated tags to commit objects so an annotated tag pointing to HEAD matches MARKER_HEAD.
if [[ "$MARKER_VALID" == "true" && ${#REFS_TO_CHECK[@]} -gt 0 ]]; then
    ALL_MATCH=true
    for entry in "${REFS_TO_CHECK[@]}"; do
        local_sha="${entry##* }"
        local_commit=$(git rev-parse "${local_sha}^{commit}" 2>/dev/null || echo "$local_sha")
        if [[ "$MARKER_HEAD" != "$local_commit" ]]; then
            ALL_MATCH=false
            break
        fi
    done
    if [[ "$ALL_MATCH" == "true" ]]; then
        RUN_UNIT_TESTS=false
    fi
fi

if [[ "$RUN_UNIT_TESTS" == "false" ]]; then
    echo "✓ Unit tests already passed in pre-commit (${AGE}s ago); skipping."
fi

if [[ "$RUN_UNIT_TESTS" == "true" ]]; then
    ALL_REFS_DOCS_ONLY=true
    for entry in "${REFS_TO_CHECK[@]}"; do
        local_ref="${entry%% *}"
        local_sha="${entry##* }"
        if ! ALL_BRANCH_CHANGES=$(get_changes_for_ref "$local_ref" "$local_sha"); then
            ALL_REFS_DOCS_ONLY=false
            break
        fi
        TOTAL_CHANGED=$(printf '%s\n' "$ALL_BRANCH_CHANGES" | grep -c . || true)
        DOCS_CHANGED=$(printf '%s\n' "$ALL_BRANCH_CHANGES" | grep -c -E '(^|/)(docs/|CHANGELOG(\.md)?$|.*\.(md|markdown)$)' || true)
        if [[ "$TOTAL_CHANGED" -eq 0 || "$DOCS_CHANGED" -ne "$TOTAL_CHANGED" ]]; then
            ALL_REFS_DOCS_ONLY=false
            break
        fi
    done

    if [[ "$ALL_REFS_DOCS_ONLY" == "true" ]]; then
        echo ""
        echo "▶ Docs-only branch diff detected; running DocsDriftTests..."
        DRIFT_ARGS=(dotnet test src/Zipper.Tests/Zipper.Tests.csproj --filter "FullyQualifiedName~DocsDriftTests" --logger "console;verbosity=quiet" --nologo)
        if [[ -f "src/Zipper.Tests/obj/project.assets.json" ]]; then
            DRIFT_ARGS+=(--no-restore)
        fi
        if ! "${DRIFT_ARGS[@]}"; then
            echo ""
            echo "❌ DocsDriftTests failed. Push aborted."
            exit 1
        fi
        echo "✓ DocsDriftTests passed (skipping full unit suite for docs-only branch)"
        RUN_UNIT_TESTS=false
    fi
fi

if [[ "$RUN_UNIT_TESTS" == "true" ]]; then
    echo ""
    echo "▶ Running unit tests..."
    UNIT_ARGS=(dotnet test src/Zipper.Tests/Zipper.Tests.csproj --logger "console;verbosity=quiet" --nologo)
    if [[ -f "src/Zipper.Tests/obj/project.assets.json" ]]; then
        UNIT_ARGS+=(--no-restore)
    fi
    if ! "${UNIT_ARGS[@]}"; then
        echo ""
        echo "❌ Unit tests failed. Push aborted."
        echo "   Run 'dotnet test' for details."
        echo "   To bypass: git push --no-verify"
        exit 1
    fi
    ANALYZER_ARGS=(dotnet test src/Zipper.Analyzers.Tests/Zipper.Analyzers.Tests.csproj --logger "console;verbosity=quiet" --nologo)
    if [[ -f "src/Zipper.Analyzers.Tests/obj/project.assets.json" ]]; then
        ANALYZER_ARGS+=(--no-restore)
    fi
    if ! "${ANALYZER_ARGS[@]}"; then
        echo ""
        echo "❌ Analyzer unit tests failed. Push aborted."
        echo "   Run 'dotnet test src/Zipper.Analyzers.Tests/Zipper.Analyzers.Tests.csproj' for details."
        echo "   To bypass: git push --no-verify"
        exit 1
    fi
    echo "✓ Unit tests passed"
fi

# ──────────────────────────────────────────────────
# 2. Mutation smoke (changed source files only) — hard gate
# ──────────────────────────────────────────────────
echo ""
echo "▶ Running mutation smoke on changed files..."
if [[ -f "./tests/run-mutation-smoke.sh" ]]; then
    # Unit tests were already verified in step 1 (either via fresh pre-commit.ok
    # marker on HEAD or by running dotnet test above), so skip the redundant
    # 20s baseline test run inside run-mutation-smoke.sh.
    if ! MUTATION_SMOKE_SKIP_BASELINE=1 bash ./tests/run-mutation-smoke.sh; then
        echo ""
        echo "❌ Mutation smoke found surviving mutants. Push aborted."
        echo "   Run 'bash tests/run-mutation-smoke.sh' for details."
        echo "   Add targeted unit tests in src/Zipper.Tests/ to kill surviving mutants."
        echo "   To bypass all: git push --no-verify"
        exit 1
    fi
    echo "✓ Mutation smoke passed"
else
    echo "❌ tests/run-mutation-smoke.sh not found. Push aborted."
    echo "   The mutation smoke script is required for pre-push checks."
    exit 1
fi

# ──────────────────────────────────────────────────
# 3. Basic E2E smoke suite (skip when no CLI/E2E files changed)
# ──────────────────────────────────────────────────
echo ""
RUN_E2E=false
for entry in "${REFS_TO_CHECK[@]}"; do
    local_ref="${entry%% *}"
    local_sha="${entry##* }"
    if ! CHANGES=$(get_changes_for_ref "$local_ref" "$local_sha"); then
        RUN_E2E=true
        break
    fi
    CLI_OR_E2E_CHANGES=$(
        printf '%s\n' "$CHANGES" |
        grep -E '(^|/)(src/|Directory\.Build\.props$|Directory\.Packages\.props$|global\.json$|zipper\.sln$|tests/run-e2e-basic\.(sh|bat)$|tests/_zipper-cli\.(sh|bat)$)' |
        grep -v -E '^src/Zipper\.Tests/|^src/Zipper\.Analyzers(\.Tests)?/' || true
    )
    if [[ -n "$CLI_OR_E2E_CHANGES" ]]; then
        RUN_E2E=true
        break
    fi
done

if [[ "$RUN_E2E" == "false" ]]; then
    echo "✓ No CLI source or basic E2E script changes since merge-base; skipping basic E2E smoke."
    echo ""
    echo "✓ All pre-push checks passed"
    exit 0
fi

echo "▶ Running basic E2E smoke tests..."

E2E_RAN=false
case "$(uname -s)" in
    Linux*|Darwin*)
        if [[ -f "./tests/run-e2e-basic.sh" ]]; then
            if ! bash ./tests/run-e2e-basic.sh; then
                echo ""
                echo "❌ Basic E2E smoke tests failed. Push aborted."
                echo "   Run 'bash tests/run-e2e-basic.sh' for details."
                echo "   To bypass: git push --no-verify"
                exit 1
            fi
            E2E_RAN=true
        else
            echo "❌ tests/run-e2e-basic.sh not found. Push aborted."
            echo "   The E2E smoke script is required for pre-push checks."
            exit 1
        fi
        ;;
    MINGW*|MSYS*|CYGWIN*)
        if [[ -f "tests/run-e2e-basic.bat" ]]; then
            if ! cmd.exe //c "tests\\run-e2e-basic.bat"; then
                echo ""
                echo "❌ Basic E2E smoke tests failed. Push aborted."
                echo "   Run 'tests\\run-e2e-basic.bat' for details."
                echo "   To bypass: git push --no-verify"
                exit 1
            fi
            E2E_RAN=true
        else
            echo "❌ tests/run-e2e-basic.bat not found. Push aborted."
            echo "   The E2E smoke script is required for pre-push checks."
            exit 1
        fi
        ;;
esac

echo ""
if [[ "$E2E_RAN" == "true" ]]; then
    echo "✓ All pre-push checks passed"
    exit 0
else
    echo "❌ E2E smoke tests were skipped. Push aborted."
    exit 1
fi
